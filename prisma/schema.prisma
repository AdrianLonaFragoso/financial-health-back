generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Month {
  id       String   @id @default(cuid())
  label    String
  year     Int
  month    Int
  ingresos Ingreso[]
  gastos   Gasto[]
  exclusiones GastoExclusion[]

  necesidades Float? @map("plan_necesidades")
  estiloVida  Float? @map("plan_estilo_vida")
  ahorro      Float? @map("plan_ahorro")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

model GastoExclusion {
  id       String @id @default(cuid())
  monthId  String @map("month_id")
  month    Month  @relation(fields: [monthId], references: [id], onDelete: Cascade)
  concepto String

  @@map("gasto_exclusiones")
}

model Ingreso {
  id       String @id @default(uuid())
  concepto String
  monto    Float
  monthId  String @map("month_id")
  month    Month  @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model Gasto {
  id         String   @id @default(uuid())
  concepto   String
  monto      Float
  categoria  String
  fin        String
  monthId    String   @map("month_id")
  month      Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  metodoPago String   @default("efectivo") @map("metodo_pago")
  creditoId  String?  @map("credito_id")
  credito    Credito? @relation(fields: [creditoId], references: [id], onDelete: SetNull)

  @@index([creditoId])
}

model Credito {
  id                 String   @id @default(uuid())
  tipo               String
  nombre             String
  logoUrl            String?
  lineaCredito       Float
  saldoUtilizado     Float
  tasaInteresMensual Float
  usuario            String
  pagoMensual        Float?
  pagosRealizados    Float?
  pagosCompletados   Int?
  pagosTotales       Int?
  gastos             Gasto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanConfig {
  id          Int      @id @default(1)
  necesidades Float
  estiloVida  Float    @map("estilo_vida")
  ahorro      Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plan_config")
}
